#!/usr/bin/env bash
#
# brave-cdp-mcp — launcher/wrapper for the Playwright MCP server that gives each
# coding-agent session its OWN isolated, logged-in Brave.
#
# Modes
# -----
#   default (macOS)        → LAUNCH mode: Playwright launches a dedicated Brave
#                            against a per-agent seeded profile, LAZILY on the
#                            first browser tool call, and closes it on shutdown.
#   BRAVE_CDP_REAL=1       → connect to the real interactive Brave on :9222.
#   BRAVE_CDP_PORT=<port>  → connect to an explicit already-running CDP port.
#   non-macOS              → connect-only to BRAVE_CDP_PORT or :9222.
#
# Why launch mode instead of connect-over-CDP for isolation
# ---------------------------------------------------------
# The agent starts the MCP server at session init just to enumerate its tools.
# Playwright only creates the browser on the FIRST tool call (tools/list returns
# static schemas), so in launch mode nothing opens until the browser is actually
# used — no per-session pop-up. And Playwright OWNS the launched browser, so it
# closes it when the MCP server shuts down (agent exit / stdio EOF). That means
# no watchdog, no port registry, no CDP port pool — the lifecycle is automatic.
# (An earlier connect-over-CDP design pre-launched Brave in this wrapper, which
# opened a browser for every session even when it was never used.)
#
# Logged in
# ---------
# The profile is seeded from the real Brave profile (cookies + encryption key),
# and scripts/install-pi.sh patches chromiumSwitches.js to drop
# --use-mock-keychain / --password-store=basic so the launched Brave decrypts
# those cookies via the real macOS "Brave Safe Storage" keychain key. The seed
# is tiny (~1 MB: just the key + cookie DBs; the heavy Extensions dir is
# symlinked) so seeding at startup is cheap even for sessions that never browse.
# Cookie-based logins (Google, GitHub, most sites) work; sites that keep auth in
# Local Storage / IndexedDB are not covered by the cheap seed.

PW_DIR="$HOME/.local/playwright-mcp"
CLI="${BRAVE_CDP_CLI:-$PW_DIR/node_modules/@playwright/mcp/cli.js}"
PROFILES_ROOT="/tmp/brave-cdp"          # /tmp so the OS reaps stale profiles
BRAVE_BIN="/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"
BASE_PROFILE="$HOME/Library/Application Support/BraveSoftware/Brave-Browser"
REAL_PORT=9222
RUNNER="${BRAVE_CDP_RUNNER:-node}"

log() { echo "[brave-cdp-mcp] $*" >&2; }

# Connect to an existing CDP browser (real Brave / explicit port). Replaces this
# process so the MCP server speaks the MCP protocol directly to the agent.
exec_connect() {  # $1 = port; remaining args forwarded to the cli
  local port="$1"; shift
  exec $RUNNER "$CLI" --cdp-endpoint "http://localhost:$port" "$@"
}

# --- connect-only modes (no isolation) ---
if [ "$(uname -s)" != "Darwin" ] || [ "${BRAVE_CDP_REAL:-}" = "1" ]; then
  exec_connect "${BRAVE_CDP_PORT:-$REAL_PORT}" "$@"
fi
if [ -n "${BRAVE_CDP_PORT:-}" ]; then
  exec_connect "$BRAVE_CDP_PORT" "$@"
fi
if [ ! -x "$BRAVE_BIN" ]; then
  log "Brave not found at '$BRAVE_BIN'; connecting to real Brave :$REAL_PORT"
  exec_connect "$REAL_PORT" "$@"
fi

# --- isolated launch mode (default on macOS) ---
mkdir -p "$PROFILES_ROOT" 2>/dev/null

# GC: drop profiles (and kill any orphaned Brave) for agents that have died.
# Normal shutdown is handled by Playwright closing the browser on stdio EOF;
# this is cheap insurance against a browser orphaned by a hard-killed server.
for d in "$PROFILES_ROOT"/*/; do
  [ -d "$d" ] || continue
  pid="$(basename "$d")"
  case "$pid" in ''|*[!0-9]*) continue ;; esac     # only numeric (pid) dirs
  kill -0 "$pid" 2>/dev/null && continue           # owner alive — keep
  pkill -f -- "--user-data-dir=${d%/}" 2>/dev/null
  rm -rf "$d"
done

# The MCP server is a direct child of the agent process (verified for pi &
# claude), so $PPID is the agent PID. Key the profile on it so lazy MCP
# re-spawns within one session reuse the same seeded profile.
AGENT_PID="$PPID"
PROFILE="$PROFILES_ROOT/$AGENT_PID"

# Seed a logged-in profile copy if we don't have one yet. Cheap: just the
# encryption key (Local State) + cookie DBs + small prefs/login data, and a
# symlink to the heavy read-only Extensions dir (so they load without copying).
if [ ! -d "$PROFILE/Default" ]; then
  mkdir -p "$PROFILE/Default" "$PROFILE/Default/Network"
  cp "$BASE_PROFILE/Local State" "$PROFILE/" 2>/dev/null
  for f in "Cookies" "Cookies-journal" "Preferences" "Secure Preferences" \
           "Login Data" "Web Data"; do
    cp "$BASE_PROFILE/Default/$f" "$PROFILE/Default/" 2>/dev/null
  done
  cp "$BASE_PROFILE/Default/Network/Cookies" "$PROFILE/Default/Network/" 2>/dev/null
  ln -s "$BASE_PROFILE/Default/Extensions" "$PROFILE/Default/Extensions" 2>/dev/null
  log "seeded isolated profile $PROFILE (agent pid $AGENT_PID)"
fi

# Launch mode: Playwright launches Brave against the persistent seeded profile
# on the first browser tool call and closes it on shutdown. No --cdp-endpoint.
exec $RUNNER "$CLI" --executable-path "$BRAVE_BIN" --user-data-dir "$PROFILE" "$@"
