{
  "mcpServers": {
    "playwright": {
      "command": "bash",
      "args": ["brave-cdp-mcp"],
      "cwd": "~/.local/playwright-mcp",
      "lifecycle": "lazy",
      "directTools": true
    },
    "svelte": {
      "command": "npx",
      "args": ["-y", "@sveltejs/mcp"],
      "lifecycle": "lazy"
    }
  }
}
