#!/usr/bin/env bash
#
# brave-cdp-mcp — launcher/wrapper for the Playwright MCP server that gives each
# coding-agent session its OWN isolated, logged-in Brave.
#
# Modes
# -----
#   default (macOS or Linux  → LAUNCH mode: Playwright launches a dedicated Brave
#   with a launchable Brave)   against a per-agent seeded profile, LAZILY on the
#                              first browser tool call, and closes it on shutdown.
#                              Headed on macOS / a Linux desktop; HEADLESS on a
#                              Linux box with no DISPLAY (cloud/server).
#   BRAVE_CDP_REAL=1       → connect to the real interactive Brave on :9222.
#   BRAVE_CDP_PORT=<port>  → connect to an explicit already-running CDP port.
#   no launchable Brave    → connect-only to BRAVE_CDP_PORT or :9222 (e.g. termux).
#
# Why launch mode instead of connect-over-CDP for isolation
# ---------------------------------------------------------
# The agent starts the MCP server at session init just to enumerate its tools.
# Playwright only creates the browser on the FIRST tool call (tools/list returns
# static schemas), so in launch mode nothing opens until the browser is actually
# used — no per-session pop-up. And Playwright OWNS the launched browser, so it
# closes it when the MCP server shuts down (agent exit / stdio EOF). That means
# no watchdog, no port registry, no CDP port pool — the lifecycle is automatic.
# (An earlier connect-over-CDP design pre-launched Brave in this wrapper, which
# opened a browser for every session even when it was never used.)
#
# Logged in
# ---------
# The profile is seeded from the real Brave profile (cookies + encryption key).
# The launched Brave must decrypt those cookies, and that differs by OS:
#   - macOS: cookies are encrypted with the "Brave Safe Storage" KEYCHAIN key, so
#     scripts/install-pi.sh patch 2 drops --use-mock-keychain / --password-store=basic
#     (both Darwin-only) to make the launched Brave use the real keychain key.
#   - Linux: cookies are encrypted with the hardcoded "peanuts" key (v10,
#     --password-store=basic, no keychain/keyring). Patch 2 does NOT run on Linux,
#     so the launched Brave keeps Playwright's default --password-store=basic and
#     decrypts the seeded cookies for free — no keychain machinery. (NOTE: on a
#     headless cloud box the box's own Brave profile may be barely logged in, so
#     "logged in as you" is weaker on Linux than macOS — the isolated Brave just
#     inherits whatever the box profile has.)
# The seed is tiny (~1 MB: just the key + cookie DBs; the heavy Extensions dir is
# symlinked) so seeding at startup is cheap even for sessions that never browse.
# Cookie-based logins (Google, GitHub, most sites) work; sites that keep auth in
# Local Storage / IndexedDB are not covered by the cheap seed.

PW_DIR="$HOME/.local/playwright-mcp"
CLI="${BRAVE_CDP_CLI:-$PW_DIR/node_modules/@playwright/mcp/cli.js}"
PROFILES_ROOT="/tmp/brave-cdp"          # /tmp so the OS reaps stale profiles
REAL_PORT=9222
RUNNER="${BRAVE_CDP_RUNNER:-node}"

# OS-specific Brave binary + the source profile we seed each agent's copy from.
case "$(uname -s)" in
  Darwin)
    BRAVE_BIN="${BRAVE_CDP_BRAVE_BIN:-/Applications/Brave Browser.app/Contents/MacOS/Brave Browser}"
    BASE_PROFILE="$HOME/Library/Application Support/BraveSoftware/Brave-Browser"
    ;;
  *)
    BRAVE_BIN="${BRAVE_CDP_BRAVE_BIN:-$(command -v brave-browser || command -v brave || true)}"
    BASE_PROFILE="$HOME/.config/BraveSoftware/Brave-Browser"
    ;;
esac

log() { echo "[brave-cdp-mcp] $*" >&2; }

# Connect to an existing CDP browser (real Brave / explicit port). Replaces this
# process so the MCP server speaks the MCP protocol directly to the agent.
exec_connect() {  # $1 = port; remaining args forwarded to the cli
  local port="$1"; shift
  exec $RUNNER "$CLI" --cdp-endpoint "http://localhost:$port" "$@"
}

# --- connect-only modes (opt-out / no launchable Brave; no isolation) ---
# Attach to the real interactive Brave (e.g. to watch it live).
if [ "${BRAVE_CDP_REAL:-}" = "1" ]; then
  exec_connect "${BRAVE_CDP_PORT:-$REAL_PORT}" "$@"
fi
# Attach to an explicitly-specified already-running CDP endpoint.
if [ -n "${BRAVE_CDP_PORT:-}" ]; then
  exec_connect "$BRAVE_CDP_PORT" "$@"
fi
# No launchable Brave on this box (e.g. termux) → connect to a remote/real :9222.
if [ ! -x "$BRAVE_BIN" ]; then
  log "no launchable Brave ('$BRAVE_BIN'); connecting to Brave :$REAL_PORT"
  exec_connect "$REAL_PORT" "$@"
fi

# --- isolated launch mode (default on macOS and Linux-with-Brave) ---
mkdir -p "$PROFILES_ROOT" 2>/dev/null

# GC: drop profiles (and kill any orphaned Brave) for agents that have died.
# Normal shutdown is handled by Playwright closing the browser on stdio EOF;
# this is cheap insurance against a browser orphaned by a hard-killed server.
for d in "$PROFILES_ROOT"/*/; do
  [ -d "$d" ] || continue
  pid="$(basename "$d")"
  case "$pid" in ''|*[!0-9]*) continue ;; esac     # only numeric (pid) dirs
  kill -0 "$pid" 2>/dev/null && continue           # owner alive — keep
  pkill -f -- "--user-data-dir=${d%/}" 2>/dev/null
  rm -rf "$d"
done

# The MCP server is a direct child of the agent process (verified for pi &
# claude), so $PPID is the agent PID. Key the profile on it so lazy MCP
# re-spawns within one session reuse the same seeded profile.
AGENT_PID="$PPID"
PROFILE="$PROFILES_ROOT/$AGENT_PID"

# Seed a logged-in profile copy if we don't have one yet. Cheap: just the
# encryption key (Local State) + cookie DBs + small prefs/login data, and a
# symlink to the heavy read-only Extensions dir (so they load without copying).
if [ ! -d "$PROFILE/Default" ]; then
  mkdir -p "$PROFILE/Default" "$PROFILE/Default/Network"
  cp "$BASE_PROFILE/Local State" "$PROFILE/" 2>/dev/null
  for f in "Cookies" "Cookies-journal" "Preferences" "Secure Preferences" \
           "Login Data" "Web Data"; do
    cp "$BASE_PROFILE/Default/$f" "$PROFILE/Default/" 2>/dev/null
  done
  cp "$BASE_PROFILE/Default/Network/Cookies" "$PROFILE/Default/Network/" 2>/dev/null
  ln -s "$BASE_PROFILE/Default/Extensions" "$PROFILE/Default/Extensions" 2>/dev/null
  log "seeded isolated profile $PROFILE (agent pid $AGENT_PID)"
fi

# Launch mode: Playwright launches Brave against the persistent seeded profile
# on the first browser tool call and closes it on shutdown. No --cdp-endpoint.
#
# On a headless Linux box (no DISPLAY) Brave must run headless, and its sandbox
# usually can't initialise there (containers / restricted user namespaces) so we
# disable it too. macOS and Linux desktops launch a real (headed) window.
# Force either way with BRAVE_CDP_HEADLESS=1/0.
LAUNCH_FLAGS=(--executable-path "$BRAVE_BIN" --user-data-dir "$PROFILE")
LAUNCH_ENV=()
headless="${BRAVE_CDP_HEADLESS:-}"
if [ -z "$headless" ] && [ "$(uname -s)" != "Darwin" ] && [ -z "${DISPLAY:-}" ]; then
  headless=1
fi
if [ "$headless" = "1" ]; then
  # Headless (cloud Linux): the sandbox usually can't initialise, so disable it.
  LAUNCH_FLAGS+=(--headless --no-sandbox)
else
  # Headed (macOS / Linux desktop): force the Chromium sandbox ON. @playwright/mcp
  # leaves chromiumSandbox undefined for an --executable-path browser — its config
  # only defaults it for browserName "chromium", which is never set on this path —
  # so Playwright passes --no-sandbox and Brave shows the alarming "unsupported
  # command-line flag: --no-sandbox" banner. PLAYWRIGHT_MCP_SANDBOX is the one knob
  # that survives that branch (CLI --sandbox gets mapped back to undefined).
  LAUNCH_ENV+=(PLAYWRIGHT_MCP_SANDBOX=true)
fi

# Resolve the runtime to an absolute path: under the macOS asuser wrapper below the
# command runs with the GUI session's PATH, which won't contain a mise/nvm node.
RUNNER_BIN="$(command -v "$RUNNER" 2>/dev/null || echo "$RUNNER")"

# macOS keychain re-association. The agent (a sesh/tmux server) runs in the launchd
# "Background" domain, which can't reach the Security Server. A Brave launched as
# its descendant then fails the "Brave Safe Storage" keychain lookup with
# errSecInteractionNotAllowed (-25308), can't decrypt the seeded v10 cookies, and
# silently DROPS them all — so the isolated Brave is logged out of everything.
# Re-associating the MCP server (and thus the Brave it spawns) with the user's
# GUI/Aqua session via `launchctl asuser` restores keychain access. The audit-
# session switch needs root, so the outer `sudo launchctl asuser` runs as root; the
# inner `sudo -u $USER` then drops straight back to the user IN that session — which
# still reaches the keychain but keeps the profile files user-owned (root-owned
# files would defeat the GC above). We only ever use passwordless sudo and probe the
# exact path first; if it's unavailable we fall back to a plain launch (isolation
# still works, just not logged in). Inline `env` passes our vars through sudo, which
# would otherwise strip them. Darwin-only — Linux cookies use the portable
# "basic"/peanuts key and need no keychain.
if [ "$(uname -s)" = "Darwin" ] && command -v launchctl >/dev/null 2>&1 \
   && sudo -n launchctl asuser "$(id -u)" sudo -n -u "$USER" true 2>/dev/null; then
  exec sudo -n launchctl asuser "$(id -u)" sudo -n -u "$USER" \
    env "${LAUNCH_ENV[@]}" "$RUNNER_BIN" "$CLI" "${LAUNCH_FLAGS[@]}" "$@"
fi
exec env "${LAUNCH_ENV[@]}" "$RUNNER_BIN" "$CLI" "${LAUNCH_FLAGS[@]}" "$@"
