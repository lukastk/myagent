{
  "settings": {
    "deferWithMissingMetadata": true,
    "scriptMode": false
  },
  "mcpServers": {
    "playwright": {
      "command": "bash",
      "args": ["mcp-lazy", "bash", "brave-cdp-mcp"],
      "cwd": "~/.local/playwright-mcp",
      "lifecycle": "lazy",
      "directTools": "search"
    },
    "playwright-main": {
      "command": "bash",
      "args": ["brave-cdp-mcp"],
      "cwd": "~/.local/playwright-mcp",
      "env": { "BRAVE_CDP_REAL": "1" },
      "lifecycle": "lazy",
      "directTools": "search"
    },
    "playwright-macstudio": {
      "command": "bash",
      "args": ["remote-playwright-mcp", "macstudio"],
      "cwd": "~/.local/playwright-mcp",
      "lifecycle": "lazy",
      "directTools": "search"
    },
    "playwright-macbook": {
      "command": "bash",
      "args": ["remote-playwright-mcp", "macbook"],
      "cwd": "~/.local/playwright-mcp",
      "lifecycle": "lazy",
      "directTools": "search"
    },
    "wispr-flow": {
      "url": "https://api.wisprflow.ai/connect/mcp",
      "lifecycle": "lazy",
      "directTools": "search"
    }
  }
}
