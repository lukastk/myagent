#!/usr/bin/env bash
#
# remote-playwright-mcp — carry the ordinary Playwright MCP stdio protocol over
# Lukas's existing ssh-target/Tailscale trust boundary to an allow-listed Mac.
#
# The selected target owns Playwright, Brave, its isolated profile, cookies,
# keychain access, downloads, and output files. Only normal MCP requests/results
# (including screenshots) cross SSH. No service listens on a network port.

set -euo pipefail

usage() {
    echo "Usage: remote-playwright-mcp <macstudio|macbook>" >&2
}

if [ "$#" -ne 1 ]; then
    usage
    exit 64
fi

target="$1"
case "$target" in
    macstudio|macbook)
        ;;
    *)
        echo "remote-playwright-mcp: disallowed target '$target' (allowed: macstudio, macbook)" >&2
        exit 64
        ;;
esac

if ! ssh_target_bin="$(command -v ssh-target 2>/dev/null)"; then
    echo "remote-playwright-mcp: ssh-target is not installed; install myrig on this client" >&2
    exit 69
fi

# Do NOT put this on ssh-target's shared ControlMaster. Multiplexing is an
# optimisation for MANY SHORT connections; this one is a single session held open
# for the whole MCP lifetime — days, routinely — so it gains nothing from the
# master while occupying one of the remote sshd's `MaxSessions` channels
# (default 10) the entire time. Past ten, the master answers every new channel
# with "Session open refused by peer", and EVERY other ssh-target call to that
# host prints that plus "disabling multiplexing" and falls back to its own
# connection: slow, alarming in a supervisor log, and indistinguishable from a
# broken host.
#
# Measured on mymain 2026-09-22, before this line existed: 22 of these sessions
# to macstudio, up to 20 days old, 5 holding channels and the other 17 ALREADY
# forced onto their own connections — which is itself the proof that none of them
# needed the master. One connection per agent is the honest cost, and it is paid
# once per browser rather than per request.
export SSH_TARGET_NO_MUX=1

# This is a fixed remote command. The only caller-controlled value is `target`,
# which was allow-listed above and is passed as a separate local argv. The
# remote command-shell PID is unique per SSH session, multiplexed or not. Every
# following step execs, so that exact decimal PID remains alive for the MCP
# lifetime and can safely key target-local kill(0)-based profile GC. LC_ALL=C
# avoids forwarding Linux's C.UTF-8 locale to macOS bash, which otherwise emits a
# harmless warning on MCP stderr.
exec "$ssh_target_bin" "$target" \
    'exec env LC_ALL=C BRAVE_CDP_PROFILE_OWNER_PID=$$ "$HOME/.local/playwright-mcp/remote-playwright-host"'
